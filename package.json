{
  "name": "whetstone-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hosted Whetstone agentic operations runtime.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm docs:lint && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "docs:lint": "node scripts/docs-lint.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "wyzant:poll": "tsx ops/wyzant-poll.ts",
    "wyzant:login": "tsx ops/wyzant-login.ts",
    "wyzant:diagnose": "tsx ops/wyzant-diagnose.ts",
    "wyzant:capture-board": "tsx ops/wyzant-capture-board.ts",
    "restore:verify": "tsx ops/verify-restore.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/client": "^6.19.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.112.2",
    "imapflow": "^1.5.0",
    "mailparser": "^3.9.14",
    "next": "^16.2.11",
    "nodemailer": "^9.0.5",
    "playwright": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.11",
    "prettier": "^3.9.0",
    "prisma": "^6.19.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
