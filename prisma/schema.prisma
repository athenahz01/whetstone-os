generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tutor {
  id           String         @id
  orgId        String         @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  name         String
  slug         String
  product      String
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  leads        Lead[]
  outcomes     Outcome[]
  profile      Profile?
  metricsDaily MetricsDaily[]

  @@unique([orgId, slug])
  @@index([orgId, active, name])
  @@map("tutors")
}

model Lead {
  id                String          @id
  orgId             String          @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  channel           String
  author            String
  text              String
  subject           String?
  location          String?
  url               String
  postedAt          DateTime        @map("posted_at") @db.Timestamptz(3)
  raw               Json?
  score             Int
  status            String          @default("new")
  firstRespondedAt  DateTime?       @map("first_responded_at") @db.Timestamptz(3)
  alertReservedAt   DateTime?       @map("alert_reserved_at") @db.Timestamptz(3)
  alertedAt         DateTime?       @map("alerted_at") @db.Timestamptz(3)
  prefillApprovedAt DateTime?       @map("prefill_approved_at") @db.Timestamptz(3)
  sentAt            DateTime?       @map("sent_at") @db.Timestamptz(3)
  sentBy            String?         @map("sent_by")
  tutorId           String?         @map("tutor_id")
  /**
   * Set when a prepared draft reaches ready-for-human-approval. KPI #5.
   */
  icpPassReadyAt    DateTime?       @map("icp_pass_ready_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  drafts            Draft[]
  outreachDrafts    OutreachDraft[]
  researchBriefs    ResearchBrief[]
  outcomes          Outcome[]
  tutor             Tutor?          @relation(fields: [tutorId], references: [id], onDelete: SetNull)

  @@index([orgId, channel, postedAt])
  @@index([orgId, tutorId, postedAt])
  @@index([orgId, alertReservedAt, score])
  @@index([orgId, alertedAt, alertReservedAt])
  @@index([orgId, sentAt, postedAt])
  @@index([orgId, icpPassReadyAt])
  @@map("leads")
}

model Draft {
  id         Int       @id @default(autoincrement())
  orgId      String    @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  leadId     String    @map("lead_id")
  tutorId    String    @map("tutor_id")
  variant    String
  body       String
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([orgId, leadId])
  @@map("drafts")
}

model Outcome {
  id           String   @id
  orgId        String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  leadId       String   @map("lead_id")
  tutorId      String?  @map("tutor_id")
  status       String
  revenueCents Int      @default(0) @map("revenue_cents")
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tutor        Tutor?   @relation(fields: [tutorId], references: [id], onDelete: SetNull)

  @@unique([orgId, leadId])
  @@index([orgId, occurredAt, status])
  @@index([orgId, tutorId, occurredAt])
  @@map("outcomes")
}

model Profile {
  id        String   @id
  orgId     String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  tutorId   String   @unique @map("tutor_id")
  shortBio  String   @map("short_bio")
  rateCents Int      @map("rate_cents")
  faq       Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("profiles")
}

model MetricsDaily {
  id                       Int      @id @default(autoincrement())
  orgId                    String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  date                     DateTime @db.Date
  tutorId                  String   @map("tutor_id")
  tutorName                String   @map("tutor_name")
  product                  String
  opportunities            Int      @default(0)
  replies                  Int      @default(0)
  callsBooked              Int      @default(0) @map("calls_booked")
  conversions              Int      @default(0)
  responseTimeTotalMinutes Int      @default(0) @map("response_time_total_minutes")
  respondedLeadCount       Int      @default(0) @map("responded_lead_count")
  revenueCents             Int      @default(0) @map("revenue_cents")
  source                   String   @default("engine")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tutor                    Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([orgId, date, tutorId])
  @@index([orgId, date, tutorId])
  @@index([orgId, source, date])
  @@map("metrics_daily")
}

model PollHeartbeat {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  source         String
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(3)
  staleAlertedAt DateTime? @map("stale_alerted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([orgId, source])
  @@index([orgId, lastRunAt])
  @@map("poll_heartbeats")
}

model Run {
  id              String         @id @default(uuid()) @db.Uuid
  orgId           String         @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  workflowId      String         @map("workflow_id")
  status          String
  trigger         String
  startedAt       DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime?      @map("ended_at") @db.Timestamptz(3)
  humanMinutes    Int            @default(0) @map("human_minutes")
  baselineMinutes Int            @default(0) @map("baseline_minutes")
  costUsd         Decimal        @default(0) @map("cost_usd") @db.Decimal(12, 6)
  humanRescue     Boolean        @default(false) @map("human_rescue")
  rescueNote      String?        @map("rescue_note")
  steps           RunStep[]
  approvals       Approval[]
  measurements    Measurement[]
  exceptions      Exception[]
  researchBrief   ResearchBrief?
  outreachDraft   OutreachDraft?

  @@index([orgId, startedAt, workflowId])
  @@index([orgId, startedAt, status, humanRescue])
  @@index([orgId, workflowId, startedAt])
  @@map("runs")
}

model ResearchBrief {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  runId        String   @unique @map("run_id") @db.Uuid
  leadId       String   @map("lead_id")
  whyFit       Json     @map("why_fit")
  hooks        Json
  disqualifier Json
  unknowns     Json
  confidence   Decimal  @db.Decimal(4, 3)
  evidence     Json
  exclusions   Json
  status       String   @default("ready_for_review")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  run          Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([orgId, leadId, createdAt])
  @@index([orgId, status, createdAt])
  @@map("research_briefs")
}

model RunStep {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  runId      String    @map("run_id") @db.Uuid
  step       String
  status     String
  inputHash  String?   @map("input_hash")
  outputRef  String?   @map("output_ref")
  error      String?
  durationMs Int       @default(0) @map("duration_ms")
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(3)
  run        Run       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([orgId, runId, startedAt])
  @@map("run_steps")
}

model Approval {
  id                  String   @id @default(uuid()) @db.Uuid
  orgId               String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  runId               String   @map("run_id") @db.Uuid
  level               String
  artifactKind        String   @map("artifact_kind")
  approvedBy          String   @map("approved_by")
  decision            String
  editDistance        Decimal  @default(0) @map("edit_distance") @db.Decimal(6, 5)
  requiredNewResearch Boolean  @default(false) @map("required_new_research")
  decidedAt           DateTime @default(now()) @map("decided_at") @db.Timestamptz(3)
  run                 Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([orgId, decidedAt, decision])
  @@index([orgId, runId, decidedAt])
  @@map("approvals")
}

model Measurement {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  kpi        String
  value      Decimal  @db.Decimal(18, 6)
  unit       String
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([orgId, kpi, recordedAt])
  @@map("measurements")
}

model Exception {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  runId      String?   @map("run_id") @db.Uuid
  workflowId String?   @map("workflow_id")
  kind       String
  severity   String
  message    String
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  run        Run?      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt, resolvedAt])
  @@index([orgId, kind, createdAt])
  @@map("exceptions")
}

model SystemFlag {
  key       String   @id
  orgId     String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  enabled   Boolean  @default(false)
  note      String?
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([orgId, key])
  @@map("system_flags")
}

model OutreachDraft {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  runId        String   @unique @map("run_id") @db.Uuid
  leadId       String   @map("lead_id")
  tutorId      String   @map("tutor_id")
  variant      String
  channel      String
  opening      String
  substance    String
  plan         String
  disqualifier String
  ask          String
  citations    Json
  contextHash  String   @map("context_hash")
  renderedBody String   @map("rendered_body")
  status       String   @default("ready_for_review")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  run          Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([orgId, leadId, createdAt])
  @@index([orgId, status, createdAt])
  @@index([orgId, variant, createdAt])
  @@map("outreach_drafts")
}

model CrmLead {
  id                     String            @id @default(uuid()) @db.Uuid
  orgId                  String            @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  /// Tab, sheet ID and student name. Two students sharing an ID stay distinct.
  identity               String            @unique
  leadRef                String            @map("lead_ref")
  tab                    String
  values                 Json
  statusRaw              String            @default("") @map("status_raw")
  statusValue            String?           @map("status_value")
  statusUnmapped         Boolean           @default(false) @map("status_unmapped")
  referrerSourceRaw      String            @default("") @map("referrer_source_raw")
  referrerSourceValue    String?           @map("referrer_source_value")
  referrerSourceUnmapped Boolean           @default(false) @map("referrer_source_unmapped")
  sources                Json
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  disputes               CrmFieldDispute[]
  touches                CrmTouch[]
  thresholdOverrides     CrmThresholdOverride[]
  actions                CrmLeadAction[]
  snoozes                CrmSnooze[]

  @@index([orgId, leadRef])
  @@index([orgId, statusValue])
  @@index([orgId, statusUnmapped])
  @@map("crm_leads")
}

model CrmFieldDispute {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  identity        String
  field           String
  workingValue    String    @map("working_value")
  workingSource   String    @map("working_source")
  alternateValue  String    @map("alternate_value")
  alternateSource String    @map("alternate_source")
  resolvedValue   String?   @map("resolved_value")
  resolvedBy      String?   @map("resolved_by")
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lead            CrmLead   @relation(fields: [identity], references: [identity], onDelete: Cascade)

  @@unique([identity, field])
  @@index([orgId, resolvedAt])
  @@map("crm_field_disputes")
}

model CrmImportRejection {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  source    String
  tab       String
  rowNumber Int      @map("row_number")
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([source, tab, rowNumber])
  @@index([orgId, createdAt])
  @@map("crm_import_rejections")
}

model CrmImportRun {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  rowsRead      Int      @map("rows_read")
  rowsImported  Int      @map("rows_imported")
  rowsRejected  Int      @map("rows_rejected")
  merged        Int
  dashboardOnly Int      @map("dashboard_only")
  copyOnly      Int      @map("copy_only")
  disputedCells Int      @map("disputed_cells")
  unmappedCells Int      @map("unmapped_cells")
  balanced      Boolean
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orgId, createdAt])
  @@map("crm_import_runs")
}

model CrmTouch {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  identity     String
  leadRef      String   @map("lead_ref")
  /// How this was learned: email, calendar or asserted by a human.
  basis        String
  /// Meeting or email. The stall thresholds depend on the difference.
  kind         String
  direction    String
  /// occurred or scheduled. A booked call is not contact that happened.
  state        String
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)
  /// The provider's own id. Never prose, so a name cannot ride in it.
  sourceRef    String   @map("source_ref")
  /// A digest of the subject. The subject line itself is never stored.
  subjectRef   String?  @map("subject_ref")
  matchedField String?  @map("matched_field")
  assertedBy   String?  @map("asserted_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lead         CrmLead  @relation(fields: [identity], references: [identity], onDelete: Cascade)

  @@unique([identity, basis, sourceRef])
  @@index([orgId, identity, occurredAt])
  @@index([orgId, state, occurredAt])
  @@index([orgId, kind, occurredAt])
  @@map("crm_touches")
}

model CrmTouchUnmatched {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  sourceRef String   @map("source_ref")
  basis     String
  /// From a closed list, so a non-match cannot become a place to put prose.
  reason    String
  /// How many leads an address reached, when that is why it did not match.
  candidateLeads Int  @default(0) @map("candidate_leads")
  scannedAt DateTime  @map("scanned_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([basis, sourceRef, scannedAt])
  @@index([orgId, scannedAt])
  @@map("crm_touch_unmatched")
}

model CrmTouchScan {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  provider       String
  windowStart    DateTime  @map("window_start") @db.Timestamptz(3)
  windowEnd      DateTime  @map("window_end") @db.Timestamptz(3)
  /// completed or failed. Every attempt writes one, so a failed scan and a
  /// quiet day are never the same absence.
  status         String
  failureReason  String?   @map("failure_reason")
  candidatesRead Int       @map("candidates_read")
  matched        Int
  unmatched      Int
  ambiguous      Int
  unaddressed    Int
  balanced       Boolean
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orgId, provider, createdAt])
  @@index([orgId, status, createdAt])
  @@map("crm_touch_scans")
}

model CrmThresholdOverride {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  identity          String
  leadRef           String   @map("lead_ref")
  stage             String
  /// The stage default this replaces, kept so the change stays legible.
  baseDays          Int      @map("base_days")
  adjustedDays      Int      @map("adjusted_days")
  /// From a closed list. A tuning reason sits next to a lead record, which is
  /// exactly where prose would otherwise carry a student's name.
  reason            String
  /// The evidence for the change: asserted touches with nothing else between.
  assertedRunLength Int      @map("asserted_run_length")
  /// Set when the run breaks and the lead returns to its stage default. The
  /// row is never deleted, so the history of a widening survives it.
  clearedAt         DateTime? @map("cleared_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  lead              CrmLead  @relation(fields: [identity], references: [identity], onDelete: Cascade)

  @@unique([identity, stage])
  @@index([orgId, clearedAt])
  @@map("crm_threshold_overrides")
}

model CrmLeadAction {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  identity   String
  leadRef    String   @map("lead_ref")
  /// From a closed list: draft, snooze, lost, spoke.
  action     String
  /// Who replied. A write nobody owns is not an attributed write.
  actor      String
  actedAt    DateTime @map("acted_at") @db.Timestamptz(3)
  /// Which day's message this answered, so a reply traces to its list.
  digestDate DateTime @map("digest_date") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lead       CrmLead  @relation(fields: [identity], references: [identity], onDelete: Cascade)

  @@unique([identity, action, digestDate])
  @@index([orgId, actedAt])
  @@map("crm_lead_actions")
}

model CrmSnooze {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @default("00000000-0000-0000-0000-000000000001") @map("org_id") @db.Uuid
  identity  String
  leadRef   String   @map("lead_ref")
  /// The lead returns on its own after this. Never a permanent hide.
  until     DateTime @db.Timestamptz(3)
  actor     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lead      CrmLead  @relation(fields: [identity], references: [identity], onDelete: Cascade)

  @@unique([identity, until])
  @@index([orgId, until])
  @@map("crm_snoozes")
}
