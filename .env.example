# Supabase Postgres. DATABASE_URL is the pooled runtime connection; DIRECT_URL
# is the direct connection used only by Prisma migrations.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@DB_HOST:5432/postgres"

# Supabase magic-link authentication.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SITE_URL="https://YOUR_VERCEL_DOMAIN"

# Server scheduling and GitHub Actions ingestion.
CRON_SECRET=""
INGEST_SECRET=""
INGEST_URL="https://YOUR_VERCEL_DOMAIN/api/ingest"

# Model drafting. Missing credentials disable drafting without stopping ingest.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
DEFAULT_TUTOR_ID="tutor-admissions"
HOT_LEAD_SCORE_THRESHOLD="70"

# Telegram alerts. Missing credentials warn once and leave ingest running.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_REVIEW_BASE_URL="https://YOUR_VERCEL_DOMAIN/today"

# Wyzant uses a JSON Playwright storage state stored as an encrypted GitHub
# Actions secret. It never logs in and never needs a persistent local path.
WYZANT_STORAGE_STATE_JSON=""
WYZANT_FEED_URL="https://www.wyzant.com/tutor/jobs"
WYZANT_TARGET_SUBJECTS="College Counseling|English|Essay Writing|SAT Reading"
WYZANT_TARGET_LOCATIONS="Manhattan|New York, NY"
WYZANT_INCLUDE_ONLINE_JOBS="true"
WYZANT_TUTOR_ID="tutor-admissions"
WYZANT_HEADLESS="true"

# Read-only IMAP inquiry ingestion.
EMAIL_IMAP_HOST=""
EMAIL_IMAP_PORT="993"
EMAIL_IMAP_SECURE="true"
EMAIL_IMAP_USER=""
EMAIL_IMAP_PASSWORD=""
EMAIL_IMAP_ACCESS_TOKEN=""
EMAIL_IMAP_MAILBOX="INBOX"
EMAIL_IMAP_LOOKBACK_HOURS="48"
EMAIL_IMAP_MAX_MESSAGES="50"
EMAIL_IMAP_MAX_BYTES="512000"
EMAIL_OWN_ADDRESS=""
EMAIL_INQUIRY_KEYWORDS="tutor|tutoring|admissions|application|SAT|essay|reading|referral"
EMAIL_TUTOR_ID="tutor-admissions"

# Restore verification points at a scratch database restored from a backup.
RESTORE_DATABASE_URL=""
